+void RobotCtlNode::run() {
+    snowbot_connection::initialize(*this, *connection_state_, [this]() {
+    //从.yaml读取零位及PD配置
+    yaml_path_zeroPos = ament_index_cpp::get_package_share_directory("snowbot_ctl_msgs") + "/config/zeropos.yaml";
+    yaml_path_desc_zeroPos = ament_index_cpp::get_package_share_directory("snowbot_ctl_msgs") + "/config/desc_zeropos.yaml";
+    yaml_path_initialPD = ament_index_cpp::get_package_share_directory("snowbot_ctl_msgs") + "/config/initialPD.yaml";
+    std::cout << " ===== 初始化关节层零位配置 ===== " << std::endl;
+    if (!loadZeroPosFromYaml(yaml_path_zeroPos)) throw std::runtime_error("zero_position_configuration_failed: "+yaml_path_zeroPos);
+    std::cout << " ===== 初始化笛卡尔空间零位配置 ===== " << std::endl;
+    if (!loadDescZeroPosFromYaml(yaml_path_desc_zeroPos)) throw std::runtime_error("cartesian_configuration_failed: "+yaml_path_desc_zeroPos);
+    std::cout << " ===== 初始化PD参数配置 ===== " << std::endl;
+    if (!loadInitialPDFromYaml(yaml_path_initialPD)) throw std::runtime_error("PD_configuration_failed: "+yaml_path_initialPD);
+        OutpInit();
+        if (control_source_ == ControlSource::Demo) demoTrajInit();
+        else if (control_source_ == ControlSource::Vr) xr_teleComu_init();
+        else jointPositionInit();
+    });
+    if (control_source_ == ControlSource::Topic) ifInitTemp=false;
+    if (control_source_ == ControlSource::Topic || !connection_state_->connection.initialized()) position_run();
+    else legacy_run();
+}
+void RobotCtlNode::position_run() {
+    rclcpp::WallRate rate(std::round(1 / TempTime));
+    while (rclcpp::ok()) {
+        fdback_get();
+        auto& link = connection_state_->connection;
+        if (!link.executing(now().seconds(), snowbot_connection::steady_now())) {
+            joint_position_cmd_pending_ = false; position_pending_=false;
+            ifFirstOutput = true;
+        } else if (joint_position_cmd_pending_) {
+            try { jointPositionOutp(); msg_publish(); }
+            catch (const std::exception& e) { link.fail(std::string("position_output_failed: ")+e.what()); }
+            joint_position_cmd_pending_ = false;
+        }
+        rate.sleep();
+    }
+}
