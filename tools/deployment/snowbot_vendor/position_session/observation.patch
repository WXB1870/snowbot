+++ b/servo_control/include/servo_control/position_observation.h
@@ -0,0 +1,58 @@
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cmath>
+#include <chrono>
+
+namespace position_session {
+constexpr uint32_t arms_mask=0x7f7f;
+// Four CSP axes, indexed by motor slot minus 16. No control decisions use this.
+struct CspPdoSnapshot {
+ int64_t send_attempt_ns=0;uint32_t command_mask=0,feedback_mask=0;
+ std::array<uint16_t,4> controlword{};
+ std::array<int8_t,4> mode_command{},mode_display{};
+ std::array<int32_t,4> target_position{},target_velocity{},actual_position{},actual_velocity{};
+ std::array<int16_t,4> target_torque{};
+};
+inline int64_t steady_ns() {
+ return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+struct Observation {
+ CspPdoSnapshot csp{};
+ std::array<float,20> position{},speed{},current{};
+ std::array<uint16_t,20> status{};
+ std::array<int16_t,20> torque_raw{};uint32_t current_valid_mask=0,torque_raw_valid_mask=0;
+ uint64_t sample=0,attempt=0,bad_wkc=0,receive_overruns=0,period_overruns=0;
+ int64_t sampled_ns=0,attempted_ns=0;
+ uint32_t valid_mask=0;
+ int wkc=0,expected_wkc=0;
+};
+// Single RT producer / single ROS consumer triple buffer. Each slot has one
+// owner; acquire/release exchanges transfer ownership, so plain copies have no
+// data races. Constant storage, no retry, allocation, mutex or bus operation.
+class ObservationCache {
+ std::array<Observation,3> slots_{};
+ std::atomic<unsigned> middle_{1};
+ unsigned back_=2,front_=0;
+public:
+ static_assert(std::atomic<unsigned>::is_always_lock_free,"lock-free mailbox required");
+ void publish(const Observation& value) {
+  slots_[back_]=value;
+  back_=middle_.exchange(back_|4u,std::memory_order_acq_rel)&3u;
+ }
+ Observation read() {
+  if(middle_.load(std::memory_order_acquire)&4u)
+   front_=middle_.exchange(front_,std::memory_order_acq_rel)&3u;
+  return slots_[front_];
+ }
+};
+inline uint32_t fault_mask(const Observation& s) {
+ uint32_t mask=0;for(unsigned i=0;i<20;++i)if(s.status[i]&8)mask|=1u<<i;return mask;
+}
+inline bool measured(const Observation& s,int64_t now,uint32_t mask=arms_mask) {
+ return s.sample>0 && s.expected_wkc>0 && s.wkc==s.expected_wkc &&
+  s.sampled_ns>0 && now>=s.sampled_ns && now-s.sampled_ns<=20000000 &&
+  (s.valid_mask&mask)==mask;
+}
+} // namespace position_session
