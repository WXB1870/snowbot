+void ServoNode::session_impedance_workspace(){
+ const auto n=impedance_left_->getNqFull();
+ session_q_.setZero(n);session_dq_.setZero(n);session_efforts_.setZero(n);
+ session_nominal_.setZero(n);session_velocity_.setZero(n);
+}
+bool ServoNode::session_impedance_inputs(const position_session::Observation& obs){
+ session_q_.setZero();session_dq_.setZero();session_efforts_.setZero();
+ for(unsigned i=0;i<20;++i){
+  if(!(obs.valid_mask&(1u<<i)) || !std::isfinite(obs.position[i]) || !std::isfinite(obs.speed[i]))return false;
+  session_q_[session_q_index_[i]]=obs.position[i];session_dq_[session_v_index_[i]]=obs.speed[i];
+ }
+ session_nominal_=session_q_;session_velocity_.setZero();
+ for(unsigned i=0;i<position_session::joint_count;++i){const auto slot=position_session::position_slot(i);
+  session_nominal_[session_q_index_[slot]]=position_trajectory_.q[i];
+  session_velocity_[session_v_index_[slot]]=position_trajectory_.v[i];
+ }
+ return true;
+}
