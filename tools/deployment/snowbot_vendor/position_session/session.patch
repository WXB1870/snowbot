+bool ServoNode::position_ready(){
+ if(!position_initialized_){position_wait_reason_=position_init_error_;return false;}
+ if(!position_endpoint())return false;
+ const auto now=this->now().nanoseconds();const auto steady=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+ if(!position_feedback_.sample){position_wait_reason_=position_feedback_.received_messages?"pdo_not_started":"publisher_found_no_message";return false;}
+ if(!position_feedback_.fresh(now,steady)){position_wait_reason_=(position_feedback_.faults&position_session::controlled_mask)?"drive_fault":"pdo_stale_or_not_advancing";return false;}
+ position_wait_reason_.clear();return true;
+}
+
+bool ServoNode::position_endpoint(){
+ const auto endpoint=position_connection::check_publisher(*this,position_feedback_sub_,"/servo_node","snowbot_ctl_msgs/msg/PositionObservation");
+ if(!endpoint.ready()){position_wait_reason_=endpoint.reason;position_feedback_.advances=0;position_feedback_.ready_sample=0;position_feedback_.ready_ros=0;return false;}
+ if(position_feedback_gid_!=endpoint.publisher_gid){position_feedback_=position_session::Tracker{};position_interrupt();position_feedback_gid_=endpoint.publisher_gid;}
+ return true;
+}
