+void ArmCtlNode::position_wait(){
+ const auto ns=[]{return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();};
+ const int64_t period=int64_t(TEMPTIME*1e9);
+ if(!position_next_tick_)position_next_tick_=ns()+period;
+ while(rclcpp::ok() && ns()<position_next_tick_){rclcpp::spin_some(this->get_node_base_interface());std::this_thread::sleep_for(std::chrono::milliseconds(1));}
+ position_next_tick_=std::max(position_next_tick_+period,ns());
+}
