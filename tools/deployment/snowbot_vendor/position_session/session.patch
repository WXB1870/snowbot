+void ServoNode::position_submit(const snowbot_ctl_msgs::msg::PositionSessionServo::SharedPtr packet){
+ const auto source=position_session::meta(packet->meta);
+
+  if(position_acceptance_.rejected.blocks(source))return;
+  // Derived bridge frames never renew TTL or trigger another generation.
+  if((position_admission_->busy()&&source==position_admission_source_)||
+     (position_target_pending_&&source==position_session::meta(position_target_pending_->meta)))return;
+  const auto ros=this->now().nanoseconds(),steady=position_session::steady_ns();
+  // Completed PAUSE owns a local fixed hold; expired relay copies cannot renew it.
+  if(position_local_hold_ && source==position_gate_.last() && !position_gate_.live(steady))return;
+  auto context=position_acceptance_.context(position_gate_,position_instance_id_,position_feedback_gid_);
+  const bool cancel_takeover=source.operation==2&&(position_target_takeover_valid_||position_acceptance_.rejected.matches(position_target_takeover_.source))&&
+   source.session==position_target_takeover_.source.session&&source.sequence>position_target_takeover_.source.sequence&&source.stamp>=position_target_takeover_.source.stamp;
+  if(cancel_takeover)context.identity=position_target_takeover_.identity;
+  position_session::ServoCommand checked;
+  const auto error=position_session::inspect_servo_command(*packet,position_origin_packet_.get(),context,checked);
+  if(error||packet->meta.reference_mode!=2||
+     (!checked.derived&&!cancel_takeover&&!position_gate_.accepts(source,ros,steady,position_session::maximum_target_pause_ttl,position_session::maximum_target_ttl))||
+     (cancel_takeover&&!position_session::fresh(source,ros,position_session::maximum_target_pause_ttl,position_session::maximum_target_ttl))||
+     (checked.derived&&(!position_gate_.live(steady)||!position_session::fresh(source,ros,position_session::maximum_target_pause_ttl,position_session::maximum_target_ttl)||packet->frame_sequence<=position_acceptance_.frame))){
+   position_target_error_.reason(error?error:"target_identity_or_order");position_cycle_reason_=position_target_error_.c_str();return;
+  }
+  if(cancel_takeover){
+   // No reference for this session has been adopted. Cancel its takeover before
+   // activation; this is not a braking trajectory or physical-stop confirmation.
+   ++position_target_barrier_;position_interrupt();
+   position_target_error_.reason("takeover_canceled_before_activation");position_cycle_reason_=position_target_error_.c_str();
+   position_rejected_session_=source.session;position_rejected_sequence_=source.sequence;position_acceptance_.rejected.reject(source,position_cycle_reason_);
+   if(position_receipts_enabled_)position_receipts_.push(source.session,source.sequence,position_feedback_.boot,position_feedback_.sample,ros,false,position_cycle_reason_);
+   return;
+  }
+  if(!checked.derived&&source.operation==1&&position_target_takeover_valid_){
+   position_target_error_.reason("takeover_already_pending");position_cycle_reason_=position_target_error_.c_str();return;
+  }
+  // Auxiliary updates retain the exact source and only refresh native PD/torque.
+  // They cannot displace a pending target or control operation.
+  if(checked.derived&&(position_target_pending_||position_admission_->busy()))return;
+  // Once a PAUSE is requested no ordinary target may replace it. Valid takeover
+  // requires a new session after interruption; Gate remains the authority owner.
+  if(position_target_pending_){const auto waiting=position_session::meta(position_target_pending_->meta);
+   if(waiting.operation==2&&source.operation!=1)return;
+   if(waiting.session==source.session&&source.sequence<=waiting.sequence)return;
+  }
+  if(source.session==position_admission_source_.session&&source.sequence<position_admission_source_.sequence)return;
+  if(!checked.derived&&source.operation==0&&position_target_pause_requested_)return;
+  if(!checked.derived&&source.operation==1){position_target_pause_requested_=false;position_target_takeover_=checked;position_target_takeover_valid_=true;}
+  if(!checked.derived&&source.operation==2){++position_target_barrier_;position_target_pause_requested_=true;}
+  if(position_target_pending_&&!position_admission_->defer_packet(position_target_pending_)){
+   position_interrupt();position_target_error_.reason("target_retirement_full");position_cycle_reason_=position_target_error_.c_str();return;
+  }
+  position_target_pending_=packet;position_target_dispatch();return;
+ }
+void ServoNode::position_target_dispatch(){
+ if(!position_target_pending_||position_admission_->busy())return;
+ const auto ros=this->now().nanoseconds(),steady=position_session::steady_ns();
+ const auto source=position_session::meta(position_target_pending_->meta);
+ position_session::TargetSnapshot snapshot;
+ if(!position_session::fresh(source,ros,position_session::maximum_target_pause_ttl,position_session::maximum_target_ttl)||( !(source==position_gate_.last())&&!position_trajectory_.snapshot(ros,steady,source.operation,position_target_prepare_ns_,position_feedback_.q,snapshot,
+   position_local_hold_ && position_gate_.generation()==position_output_.admission_generation && !position_output_.failure_reason))){
+  if(source.operation==1&&position_target_takeover_valid_&&source==position_target_takeover_.source)position_interrupt();
+  position_acceptance_.rejected.reject(source,"target_snapshot_or_expired");position_rejected_session_=source.session;position_rejected_sequence_=source.sequence;
+  position_cycle_reason_=position_acceptance_.rejected.reason.c_str();position_admission_->defer_packet(position_target_pending_);return;
+ }
+ auto context=position_acceptance_.context(position_gate_,position_instance_id_,position_feedback_gid_);context.barrier=position_target_barrier_;
+ if(position_admission_->submit(std::move(position_target_pending_),trajectory_max_velocity_,trajectory_max_acceleration_,trajectory_max_jerk_,context,position_origin_packet_,snapshot))position_admission_source_=source;
+}
+void ServoNode::position_poll(){
+ if(!position_admission_)return;
+ auto* result=position_admission_->poll();if(!result){position_target_dispatch();return;}
+ const auto source=position_session::meta(result->packet->meta);
+ const auto error=result->context.barrier!=position_target_barrier_?"target_superseded_by_pause":result->error.empty()?position_acceptance_.commit(result->command,result->prepared.get(),result->context,
+   position_instance_id_,position_initialized_&&position_startup_complete_&&!shutdown_mode_&&!sigInterrupt.load(),!impedance_enable_,position_policy_,
+   position_feedback_,this->now().nanoseconds(),position_session::steady_ns(),position_gate_,position_trajectory_,position_output_,position_interval_):result->error.c_str();
+ if(error&&((std::strcmp(error,"target_generation_late")==0&&position_session::fresh(source,this->now().nanoseconds(),position_session::maximum_target_pause_ttl,position_session::maximum_target_ttl))||std::strcmp(error,"target_superseded_by_pause")==0)){
+  // A late ordinary result is retried from a new dated snapshot if no newer
+  // pending target exists. New input never cancels a completed valid result.
+  if(!position_target_pending_&&result->context.barrier==position_target_barrier_&&std::strcmp(error,"target_generation_late")==0)position_target_pending_=result->packet;
+ }else if(error){
+  if(source.operation==1&&position_target_takeover_valid_&&source==position_target_takeover_.source)position_interrupt();
+  position_acceptance_.rejected.reject(source,error);position_rejected_session_=source.session;position_rejected_sequence_=source.sequence;
+  position_cycle_reason_=position_acceptance_.rejected.reason.c_str();
+ }else{
+  if(!result->command.derived){
+   result->retired_packet=std::move(position_origin_packet_);position_origin_packet_=result->packet;
+   position_local_hold_=false;
+   if(source.operation==1)position_target_takeover_valid_=false;
+   if(source.operation==1)for(unsigned i=0;i<position_session::joint_count;++i)EtherCAT_setSingleMotorEnable(position_session::position_slot(i),true);
+  }
+  if(source.operation==1)position_output_.cycle_fault={};
+  position_rejected_session_=position_rejected_sequence_=0;position_cycle_reason_=nullptr;
+
+ }
+ if(position_receipts_enabled_ && !result->command.derived && !(error&&(std::strcmp(error,"target_generation_late")==0||std::strcmp(error,"target_superseded_by_pause")==0)))position_receipts_.push(source.session,source.sequence,
+   position_feedback_.boot,position_feedback_.sample,this->now().nanoseconds(),!error,error);
+ position_admission_->release(result);
+}
+void ServoNode::position_step(){
+ if(!position_gate_.selected())return;
+ const auto now=position_session::steady_ns();const auto dt=position_interval_.tick(now);
+ if(impedance_enable_){position_interrupt();position_output_.deadline=now;position_output_.failure_reason=position_session::CONTROL_SOURCE_CONFLICT;position_cycle_reason_="control_source_conflict";EtherCAT_positionOutput(position_output_);return;}
+ const bool local_hold=position_local_hold_ &&
+  position_output_.operation==2 && position_output_.trajectory_phase==4 && position_output_.failure_reason==0 &&
+  position_gate_.last().session==position_output_.session && position_gate_.last().sequence==position_output_.sequence &&
+  position_gate_.generation()==position_output_.admission_generation;
+ // Admission identity survives clock conversion; revocation changes generation.
+ // Fresh sampling, feedback and all tracking limits remain required.
+ if((position_gate_.live(now)||local_hold) && position_feedback_.fresh(this->now().nanoseconds(),now)){
+  bool valid=std::isfinite(dt)&&dt>0&&dt<=.01;
+  uint8_t checks=valid?0:1;int16_t failed_axis=-1;
+
+   const bool sampled=position_trajectory_.sample(now);if(!sampled)checks|=2;
+   valid=sampled&&valid;
+   if(valid){const auto& source=position_trajectory_.source();
+    position_output_.session=source.session;position_output_.sequence=source.sequence;position_output_.operation=source.operation;
+    position_output_.deadline=position_trajectory_.deadline();position_output_.source_stamp_ns=source.stamp;position_output_.expires_at_ns=source.expires;
+    position_output_.trajectory=true;position_output_.reference_mode=position_reference_mode_;position_output_.trajectory_phase=position_trajectory_.phase(now);position_output_.segment_id=position_trajectory_.id();position_output_.admission_generation=position_trajectory_.admission();
+    position_output_.sample_time_ns=this->now().nanoseconds();position_output_.rt_deadline=now+20000000;
+    position_output_.reference_position=position_trajectory_.q;position_output_.reference_speed=position_trajectory_.v;position_output_.reference_acceleration=position_trajectory_.a;
+    for(unsigned i=0;i<position_session::joint_count;++i){position_output_.q[i]=position_trajectory_.q[i];position_output_.v[i]=position_trajectory_.v[i];}
+   }
+
+  const auto& reference=position_trajectory_.q;
+  for(unsigned i=0;i<position_session::joint_count;++i){
+   uint8_t axis_checks=0;
+   if(!std::isfinite(reference[i]))axis_checks|=4;
+   if(reference[i]<position_session::lower[i]||reference[i]>position_session::upper[i])axis_checks|=8;
+   if(std::abs(reference[i]-position_feedback_.q[i])>.5)axis_checks|=16;
+   if(axis_checks){valid=false;checks|=axis_checks;if(failed_axis<0)failed_axis=int16_t(i);}
+  }
+  if(!valid && position_output_.failure_reason!=position_session::CYCLE_OR_TRACKING_ERROR){
+   auto& fault=position_output_.cycle_fault;fault={};fault.origin=1;fault.checks=checks;fault.axis=failed_axis;
+   fault.detected_ns=now;fault.dt_s=dt;fault.session=position_output_.session;fault.sequence=position_output_.sequence;fault.pdo_sample=position_feedback_.sample;
+   if(failed_axis>=0){fault.reference=reference[failed_axis];fault.measured=position_feedback_.q[failed_axis];}
+  }
+  if(!valid){position_interrupt();position_output_.deadline=now;position_output_.failure_reason=position_session::CYCLE_OR_TRACKING_ERROR;position_cycle_reason_="cycle_limit_or_tracking_error";}
+ }
+ if(position_output_.operation==2 && position_output_.trajectory_phase==4 &&
+    position_output_.failure_reason==0 && position_gate_.live(now))position_local_hold_=true;
+ position_output_.nominal_hold=position_local_hold_ && position_gate_.generation()==position_output_.admission_generation && position_output_.failure_reason==0;
+ EtherCAT_positionOutput(position_output_);
+}
