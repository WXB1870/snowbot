+void ServoNode::position_poll(){
+ if(!position_admission_)return;
+ auto* result=position_admission_->poll();if(!result)return;
+ if(!result->error.empty()){
+  position_rejected_session_=result->packet->meta.session;position_rejected_sequence_=result->packet->meta.sequence;position_rejection_=result->error;position_rejected_.reject(position_session::meta(result->packet->meta),result->error);
+ }else{
+  // Curve construction/validation and destruction remain on the admission worker.
+  result->retired_packet=std::move(position_origin_packet_);
+  position_prepared_=result->prepared.get();position_callback(result->packet);position_prepared_=nullptr;
+  if(!position_origin_packet_)position_origin_packet_=std::move(result->retired_packet);
+ }
+ position_admission_->release(result);
+}
+void ServoNode::position_step(){
+ if(!position_gate_.selected())return;
+ const auto now=position_session::steady_ns();const auto dt=position_interval_.tick(now);
+ if(impedance_enable_){position_gate_.interrupt();position_output_.deadline=now;position_output_.failure_reason=position_session::CONTROL_SOURCE_CONFLICT;position_rejection_="control_source_conflict";EtherCAT_positionOutput(position_output_);return;}
+ // Never let a local ROS loop stall extend the source's monotonic deadline.
+ if(position_gate_.live(now) && position_feedback_.fresh(this->now().nanoseconds(),now)){
+  bool valid=std::isfinite(dt)&&dt>0&&dt<=.01;
+  if(position_reference_mode_){
+   valid=position_trajectory_.sample(now)&&valid;
+   if(valid){const auto& source=position_trajectory_.source();
+    position_output_.session=source.session;position_output_.sequence=source.sequence;position_output_.operation=source.operation;
+    position_output_.deadline=position_trajectory_.deadline();position_output_.source_stamp_ns=source.stamp;position_output_.expires_at_ns=source.expires;
+    position_output_.trajectory=true;position_output_.trajectory_phase=position_trajectory_.phase(now);position_output_.segment_id=position_trajectory_.id();
+    position_output_.sample_time_ns=this->now().nanoseconds();position_output_.rt_deadline=now+20000000;
+    position_output_.reference_position=position_trajectory_.q;position_output_.reference_speed=position_trajectory_.v;position_output_.reference_acceleration=position_trajectory_.a;
+    for(unsigned i=0;i<position_session::joint_count;++i){position_output_.q[i]=position_trajectory_.q[i];position_output_.v[i]=position_trajectory_.v[i];}
+   }
+  }else{
+   valid=position_follower_.step(dt)&&valid;
+   for(unsigned i=0;i<position_session::joint_count;++i){position_output_.q[i]=position_follower_.q[i];position_output_.v[i]=position_follower_.v[i];}
+  }
+  const auto& reference=position_reference_mode_?position_trajectory_.q:position_follower_.q;
+  for(unsigned i=0;i<position_session::joint_count;++i)if(!std::isfinite(reference[i])||reference[i]<position_session::lower[i]||reference[i]>position_session::upper[i]||std::abs(reference[i]-position_feedback_.q[i])>.25)valid=false;
+  if(!valid){position_gate_.interrupt();position_output_.deadline=now;position_output_.failure_reason=position_session::CYCLE_OR_TRACKING_ERROR;position_rejection_="cycle_limit_or_tracking_error";}
+ }
+ EtherCAT_positionOutput(position_output_);
+}
+
+bool ServoNode::position_ready(){
+ if(!position_initialized_){position_wait_reason_=position_init_error_;return false;}
+ if(!position_endpoint())return false;
+ const auto now=this->now().nanoseconds();const auto steady=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+ if(!position_feedback_.sample){position_wait_reason_=position_feedback_.received_messages?"pdo_not_started":"publisher_found_no_message";return false;}
+ if(!position_feedback_.fresh(now,steady)){position_wait_reason_=(position_feedback_.faults&position_session::controlled_mask)?"drive_fault":"pdo_stale_or_not_advancing";return false;}
+ position_wait_reason_.clear();return true;
+}
+
+bool ServoNode::position_endpoint(){
+ const auto endpoint=position_connection::check_publisher(*this,position_feedback_sub_,"/servo_node","snowbot_ctl_msgs/msg/PositionObservation");
+ if(!endpoint.ready()){position_wait_reason_=endpoint.reason;position_feedback_.advances=0;position_feedback_.ready_sample=0;position_feedback_.ready_ros=0;return false;}
+ if(position_feedback_gid_!=endpoint.publisher_gid){position_feedback_=position_session::Tracker{};position_gate_.interrupt();position_feedback_gid_=endpoint.publisher_gid;}
+ return true;
+}
