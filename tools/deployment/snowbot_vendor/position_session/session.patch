+void ServoNode::position_interrupt(){
+ position_gate_.invalidate_pending(position_target_takeover_valid_?position_target_takeover_.source:position_session::Meta{});
+ position_target_takeover_valid_=false;position_target_pause_requested_=true;
+ if(position_target_pending_&&position_admission_)position_admission_->defer_packet(position_target_pending_);
