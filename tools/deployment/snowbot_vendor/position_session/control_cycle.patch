+bool ServoNode::position_start_control(){
+    position_control_stop_.store(false);position_control_failed_=false;
+    std::promise<int> ready;auto started=ready.get_future();
+    position_control_thread_=std::thread([this,ready=std::move(ready)]()mutable{
+#ifdef __linux__
+        position_control_tid_.store(int(::syscall(SYS_gettid)));
+#endif
+        sched_param param{};param.sched_priority=20;
+        const int rc=pthread_setschedparam(pthread_self(),SCHED_FIFO,&param);
+        ready.set_value(rc);if(rc)return;
+        try{
+            auto next=std::chrono::steady_clock::now();
+            while(!position_control_stop_.load() && !sigInterrupt.load() && rclcpp::ok()){
+                {
+                    std::lock_guard<position_session::PriorityMutex> lock(position_control_mutex_);
+                    position_control_timing_.bind(position_gate_.last().session);
+                    position_control_timing_.mark(position_session::LoopTiming::Admission,position_session::steady_ns());
+                    position_poll();
+                    position_control_timing_.mark(position_session::LoopTiming::Sample,position_session::steady_ns());
+                    position_step();
+                    position_control_timing_.mark(position_session::LoopTiming::Sleep,position_session::steady_ns());
+                }
+                next+=std::chrono::milliseconds(1);
+                const auto now=std::chrono::steady_clock::now();
+                if(next<=now)next=now+std::chrono::milliseconds(1);
+                std::this_thread::sleep_until(next);
+            }
+        }catch(...){position_control_error_=std::current_exception();sigInterrupt.store(true);}
+    });
+    const int rc=started.get();
+    if(rc){position_stop_control();RCLCPP_ERROR(this->get_logger(),"POSITION_CONTROL_FIFO_FAILED: %s",std::strerror(rc));return false;}
+    RCLCPP_INFO(this->get_logger(),"POSITION_CONTROL_FIFO priority=20 period_us=1000; ROS callbacks remain SCHED_OTHER");
+    RCLCPP_INFO(this->get_logger(),"[SCHED-THREAD] role=control pid=%d tid=%d mono_ns=%lld",int(::getpid()),position_control_tid_.load(),(long long)position_session::steady_ns());
+    return true;
+}
+void ServoNode::position_stop_control(){
+    position_control_stop_.store(true);
+    if(position_control_thread_.joinable())position_control_thread_.join();
+    if(position_control_error_){
+        try{std::rethrow_exception(position_control_error_);}
+        catch(const std::exception& e){RCLCPP_ERROR(this->get_logger(),"POSITION_CONTROL_FAILED: %s",e.what());}
+        catch(...){RCLCPP_ERROR(this->get_logger(),"POSITION_CONTROL_FAILED: unknown exception");}
+        position_control_error_=nullptr;position_control_failed_=true;
+    }
+    if(position_control_failed_)shutdown_exit_code_=1;
+}

