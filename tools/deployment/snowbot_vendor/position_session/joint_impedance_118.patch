+void CartesianImpedanceController::shareRobotData(
+    std::shared_ptr<pinocchio::Data> shared) {
+  robot_data_ = std::move(shared);
+  skip_compute_all_terms_ = true;
+}
+
+void CartesianImpedanceController::forceUpdateRobot(
+    const VectorXd& q_full, const VectorXd& dq_full) {
+  if (!initialized_) return;
+  q_full_cache_ = q_full;
+  dq_full_cache_ = dq_full;
+  if (efforts_full_cache_.size() < q_full.size()) {
+    efforts_full_cache_ = VectorXd::Zero(q_full.size());
+  }
+  // 无论是否共享 robot_data_, robot_q_/robot_dq_ 必须每帧更新
+  // (阻抗 Kp/Kd 反馈依赖它们). computeAllTerms+updateFramePlacements
+  // 只在非共享模式下执行 (左臂做一次, 右臂从共享 Data 读).
+  for (size_t i = 0; i < n_dof_; ++i) {
+    robot_q_(i) = q_full_cache_(controlled_q_idx_[i]);
+    robot_dq_(i) = dq_full_cache_(controlled_v_idx_[i]);
+    if (has_effort_states_) {
+      robot_efforts_(i) = efforts_full_cache_(controlled_v_idx_[i]);
+    }
+  }
+  if (skip_compute_all_terms_) {
+    return;
+  }
+  pinocchio::computeAllTerms(robot_model_, *robot_data_, q_full_cache_,
+                             dq_full_cache_);
+  robot_data_->M.triangularView<Eigen::StrictlyLower>() =
+      robot_data_->M.transpose().triangularView<Eigen::StrictlyLower>();
+  pinocchio::updateFramePlacements(robot_model_, *robot_data_);
+}
+
+const VectorXd& CartesianImpedanceController::computeGravityCached() {
+  if (!initialized_) {
+    if (g_sub_live_.size() != n_dof_) g_sub_live_.setZero(n_dof_);
+    return g_sub_live_;
+  }
+  if (g_sub_live_.size() != n_dof_) g_sub_live_.resize(n_dof_);
+  for (size_t i = 0; i < n_dof_; ++i) {
+    g_sub_live_(i) = kt_gravity_(i) * robot_data_->g(controlled_v_idx_[i]);
+  }
+  return g_sub_live_;
+}
+
+void CartesianImpedanceController::updateNoRobot(
+    const VectorXd& q_full, const VectorXd& dq_full,
+    const VectorXd& efforts_full, const Vector6d& sensor_wrench,
+    double dt) {
+  if (!initialized_) return;
+  // 跳过 updateRobot(), 假设外部已 forceUpdateRobot() 更新过缓存.
+  delta_t_ = (dt > 1e-6) ? dt : 0.001;
+
+  ee_rotation_in_base_ = robot_data_->oMf[ee_frame_].rotation();
+
+  Vector6d wrench_in_base;
+  const Eigen::Matrix3d R_sensor_base = ee_rotation_in_base_ * R_sensor_to_ee_;
+  const Eigen::Vector3d F_in_base = R_sensor_base * sensor_wrench.head<3>();
+  const Eigen::Vector3d M_in_base = R_sensor_base * sensor_wrench.tail<3>();
+  const Eigen::Vector3d r_sensor_in_base = ee_rotation_in_base_ * t_sensor_in_ee_;
+  wrench_in_base.head<3>() = F_in_base;
+  wrench_in_base.tail<3>() = M_in_base + r_sensor_in_base.cross(F_in_base);
+
+  wrench_in_base -= computeToolGravityInBase();
+
+  if (has_sensor_bias_) {
+    wrench_in_base -= sensor_wrench_bias_in_base_;
+  }
+  sensor_wrench_ = wrench_in_base;
+
+  updateDeviationAndReference();
+  updateEffortCommands();
+  publishStatus();
+}
+
+void CartesianImpedanceController::setMode(ImpedanceMode mode) {
+  if (!initialized_) return;
+  if (mode_ == mode) return;
+  mode_ = mode;
+
+  // 双向切换通用: 全链路 reset reference + 本地状态 → 当前实际值,
+  // 关闭外部输入闸门, 零初始偏差, 零飞车风险.
+  // resetReferenceAndStateToActual() 内部已处理:
+  //   - position/quaternion/twist/accel target+filtered → 当前实际
+  //   - q_d_nullspace_target/filtered → robot_q_
+  //   - reference_ 本体 → 同步
+  //   - rt_reference_ (加锁) → 同步
+  //   - rt_reference_valid_ = false → 关闭 trajectory_planner 覆盖
+  resetReferenceAndStateToActual();
+
+  if (mode == ImpedanceMode::CARTESIAN) {
+    // JOINT → CARTESIAN 独有: JOINT 模式下积分器/哈密顿量/实际加速度
+    // 没在笛卡尔空间使用过, 切回 CARTESIAN 时清零防止残留尖峰.
+    q_integral_accum_.setZero();
+    clearExternalWrench();
+    hamiltonian_ = 0;
+    hamiltonian_filtered_ = 0;
+    hamiltonian_last_ = 0;
+    hamiltonian_derivative_ = 0;
+    actual_accel_.setZero();
+    actual_twist_last_.setZero();
+  }
+
+  RCLCPP_INFO(node_->get_logger(),
+              "[Impedance] %s switched to %s mode",
+              config_.ee_link.c_str(),
+              mode == ImpedanceMode::JOINT ? "JOINT" : "CARTESIAN");
+}
+
+void CartesianImpedanceController::resetReferenceAndStateToActual() {
+  // ① 计算当前实际 TCP 位姿: 直接从 robot_data_->oMf[ee_frame_] 算,
+  //    比缓存 p_tcp_in_base_ 更及时 (缓存在 updateDeviationAndReference 里
+  //    才更新, 比 forceUpdateRobot 晚一拍).
+  //    注: 若本函数在 forceUpdateRobot 之前被异步调用 (ROS2 callback),
+  //    robot_data_->oMf 是上一帧的值, 误差 ≤ 1ms 运动, 完全可接受.
+  const Eigen::Vector3d p_ee_now = robot_data_->oMf[ee_frame_].translation();
+  const Eigen::Matrix3d& R_ee_now = robot_data_->oMf[ee_frame_].rotation();
+  const Eigen::Vector3d p_tcp_now = p_ee_now + R_ee_now * t_ee_in_tcp_;
+  Eigen::Quaterniond q_tcp_now(R_ee_now * R_ee_to_tcp_);
+  q_tcp_now.normalize();
+
+  // ② 本地 target/filtered → 当前实际值
+  position_d_target_    = p_tcp_now;
+  position_d_filtered_  = p_tcp_now;
+  orientation_d_target_  = q_tcp_now;
+  orientation_d_filtered_ = q_tcp_now;
+  desired_twist_target_.setZero();
+  desired_twist_filtered_.setZero();
+  desired_pose_accel_target_.setZero();
+  desired_pose_accel_filtered_.setZero();
+
+  q_d_nullspace_target_   = robot_q_;
+  q_d_nullspace_filtered_ = robot_q_;
+  q_d_filtered_prev_      = robot_q_;
+  dq_d_desired_.setZero();
+
+  // ③ 同步 reference_ 本体 (当前帧 updateDeviationAndReference 会读它)
+  reference_.pose.position.x = p_tcp_now.x();
+  reference_.pose.position.y = p_tcp_now.y();
+  reference_.pose.position.z = p_tcp_now.z();
+  reference_.pose.orientation.w = q_tcp_now.w();
+  reference_.pose.orientation.x = q_tcp_now.x();
+  reference_.pose.orientation.y = q_tcp_now.y();
+  reference_.pose.orientation.z = q_tcp_now.z();
+  reference_.pose_twist.linear.x  = 0.0;
+  reference_.pose_twist.linear.y  = 0.0;
+  reference_.pose_twist.linear.z  = 0.0;
+  reference_.pose_twist.angular.x = 0.0;
+  reference_.pose_twist.angular.y = 0.0;
+  reference_.pose_twist.angular.z = 0.0;
+  reference_.pose_accel.linear.x  = 0.0;
+  reference_.pose_accel.linear.y  = 0.0;
+  reference_.pose_accel.linear.z  = 0.0;
+  reference_.pose_accel.angular.x = 0.0;
+  reference_.pose_accel.angular.y = 0.0;
+  reference_.pose_accel.angular.z = 0.0;
+  const size_t n = std::min(static_cast<size_t>(n_dof_), size_t{7});
+  for (size_t i = 0; i < n; ++i) {
+    reference_.q_d_nullspace[i] = (i < robot_q_.size()) ? robot_q_(i) : 0.0;
+  }
+
+  // ④ 同步 rt_reference_ + 关闭闸门 (同一把锁内原子完成, 缩小与
+  //    reference_sub_ 回调的 race 窗口). 即使回调在本锁释放后立即
+  //    抢锁写回旧 trajectory_planner 消息并 store(true), updateDeviation
+  //    在当前帧内仍会读到本地 target/default (已重置), 飞车风险被
