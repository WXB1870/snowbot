+  if (!initialized_) return;
+  for (size_t i = 0; i < n_dof_ && i < K.size(); ++i)
+    joint_stiffness_diag_.diagonal()(i) = K[i];
+  for (size_t i = 0; i < n_dof_ && i < D.size(); ++i)
+    joint_damping_diag_.diagonal()(i) = D[i];
