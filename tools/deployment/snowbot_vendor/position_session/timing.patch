--- a/servo_control/include/servo_control/position_clock.h
+++ b/servo_control/include/servo_control/position_clock.h
@@ -0,0 +1,11 @@
+#pragma once
+#include <cstdint>
+namespace position_session {
+// New position session only. Startup/exit and legacy timing remain untouched.
+class Interval {
+ int64_t last_=0;
+public:
+ void reset(int64_t now){last_=now;}
+ double tick(int64_t now){const auto old=last_;last_=now;return old>0 && now>old ? (now-old)*1e-9 : -1.;}
+};
+} // namespace position_session
