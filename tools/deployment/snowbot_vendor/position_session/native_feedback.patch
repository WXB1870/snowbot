+  site,(unsigned long long)position_gate_.last().session,(unsigned long long)position_gate_.last().sequence,
+  (unsigned long long)position_command_session_,(unsigned long long)position_command_sequence_,(unsigned long long)position_command_forward_sequence_,
+  (unsigned long long)position_gate_.generation(),position_wait_reason_.c_str(),position_rejection_.c_str(),
+  (ros-position_feedback_.source)*1e-6,(steady-position_feedback_.received)*1e-6,(steady-position_feedback_.progress)*1e-6,position_feedback_.age*1000.,
+  (unsigned long long)position_feedback_.sample,position_feedback_.wkc,position_feedback_.expected,unsigned(position_feedback_.valid),unsigned(position_feedback_.faults),position_feedback_.advances,
+  position_nominal_stamp_?(ros-position_nominal_stamp_)*1e-6:-1.,(position_nominal_bootstrap_expires_-ros)*1e-6,(position_gate_.deadline()-steady)*1e-6,
+  elapsed_ms(position_cycle_begin_,steady),elapsed_ms(position_cycle_begin_,position_pump_end_),
+  elapsed_ms(position_init_begin_,position_init_end_),elapsed_ms(position_control_begin_,position_control_end_),elapsed_ms(position_control_end_,steady),
+  position_cycle_cpu_begin_?(cpu-position_cycle_cpu_begin_)*1e-6:-1.,
+  position_control_cpu_begin_?((position_control_cpu_end_?position_control_cpu_end_:cpu)-position_control_cpu_begin_)*1e-6:-1.,
+  usage.ru_nvcsw-position_cycle_nvcsw_,usage.ru_nivcsw-position_cycle_nivcsw_,(long long)steady);
+}
