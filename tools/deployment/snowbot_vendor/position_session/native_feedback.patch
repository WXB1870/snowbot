+// The validated PDO observation also owns the measured inputs used by IK/PD.
+// Keep arm motor-slot order and original units; no targets or timestamps are made.
+void ArmCtlNode::position_log_interrupt(const char* site){
+ // Log the first interruption before later new_session_required rejections hide it.
+ if(!position_gate_.selected() || position_gate_.deadline()==0)return;
+ const auto ros=this->now().nanoseconds();
+ const auto steady=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+ const auto elapsed_ms=[steady](int64_t begin,int64_t end){return begin>0 ? ((end>0?end:steady)-begin)*1e-6 : -1.;};
+ RCLCPP_WARN(this->get_logger(),
+  "POSITION_GATE_INTERRUPT layer=middle site=%s session=%llu seq=%llu rx_session=%llu rx_seq=%llu forwarded_seq=%llu generation=%llu wait_reason=%s rejection=%s source_age_ms=%.3f receive_age_ms=%.3f progress_age_ms=%.3f pdo_age_ms=%.3f pdo=%llu WKC=%d/%d valid=0x%x faults=0x%x advances=%u nominal_age_ms=%.3f bootstrap_remaining_ms=%.3f gate_remaining_ms=%.3f cycle_ms=%.3f pump_ms=%.3f init_ms=%.3f control_ms=%.3f post_control_ms=%.3f",
+  site,(unsigned long long)position_gate_.last().session,(unsigned long long)position_gate_.last().sequence,
+  (unsigned long long)position_command_session_,(unsigned long long)position_command_sequence_,(unsigned long long)position_command_forward_sequence_,
+  (unsigned long long)position_gate_.generation(),position_wait_reason_.c_str(),position_rejection_.c_str(),
+  (ros-position_feedback_.source)*1e-6,(steady-position_feedback_.received)*1e-6,(steady-position_feedback_.progress)*1e-6,position_feedback_.age*1000.,
+  (unsigned long long)position_feedback_.sample,position_feedback_.wkc,position_feedback_.expected,unsigned(position_feedback_.valid),unsigned(position_feedback_.faults),position_feedback_.advances,
+  position_nominal_stamp_?(ros-position_nominal_stamp_)*1e-6:-1.,(position_nominal_bootstrap_expires_-ros)*1e-6,(position_gate_.deadline()-steady)*1e-6,
+  elapsed_ms(position_cycle_begin_,steady),elapsed_ms(position_cycle_begin_,position_pump_end_),
+  elapsed_ms(position_init_begin_,position_init_end_),elapsed_ms(position_control_begin_,position_control_end_),elapsed_ms(position_control_end_,steady));
+}
+
+bool ArmCtlNode::position_native_feedback(const snowbot_ctl_msgs::msg::PositionObservation& msg,int64_t ros,int64_t steady){
+ const bool ready=position_feedback_.fresh(ros,steady);
+ if(position_initialized_ && ready){
+  for(unsigned i=0;i<LARMDOF;++i){lArm_pos_fdback[i]=msg.position[i];lArm_spd_fdback[i]=msg.speed[i];lArm_iq_fdback[i]=msg.current[i];}
+  for(unsigned i=0;i<RARMDOF;++i){rArm_pos_fdback[i]=msg.position[i+8];rArm_spd_fdback[i]=msg.speed[i+8];rArm_iq_fdback[i]=msg.current[i+8];}
+  native_feedback_seen_=true;has_received_command_=true;
+ }
+ return ready;
+}
