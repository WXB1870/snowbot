+// The validated PDO observation also owns the measured inputs used by IK/PD.
+// Keep arm motor-slot order and original units; no targets or timestamps are made.
+bool ArmCtlNode::position_native_feedback(const snowbot_ctl_msgs::msg::PositionObservation& msg,int64_t ros,int64_t steady){
+ const bool ready=position_feedback_.fresh(ros,steady);
+ if(position_initialized_ && ready){
+  for(unsigned i=0;i<LARMDOF;++i){lArm_pos_fdback[i]=msg.position[i];lArm_spd_fdback[i]=msg.speed[i];lArm_iq_fdback[i]=msg.current[i];}
+  for(unsigned i=0;i<RARMDOF;++i){rArm_pos_fdback[i]=msg.position[i+8];rArm_spd_fdback[i]=msg.speed[i+8];rArm_iq_fdback[i]=msg.current[i+8];}
+  native_feedback_seen_=true;has_received_command_=true;
+ }
+ return ready;
+}
