+   static_cast<long long>(f.progress), static_cast<long long>(f.received), f.age, f.advances,
+   f.wkc, f.expected, static_cast<unsigned>(f.valid), static_cast<unsigned>(f.faults),
+   static_cast<unsigned long long>(f.boot), static_cast<unsigned long long>(f.sample),
+   static_cast<unsigned long long>(f.received_messages));
+  return false;
+ }
  position_wait_reason_.clear();return true;
 }
 
