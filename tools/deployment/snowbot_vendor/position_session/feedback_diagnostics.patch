+   "Position feedback check: ros_ns=%lld steady_ns=%lld source_ns=%lld progress_ns=%lld received_ns=%lld pdo_age_s=%.12f advances=%u wkc=%d expected=%d valid=0x%08x faults=0x%08x boot=%llu sample=%llu received_messages=%llu",
