--- a/servo_control/include/servo_control/position_follower.h
+++ b/servo_control/include/servo_control/position_follower.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <array>
+#include "position_session_contract.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+namespace position_session {
+struct Follower {
+ std::array<double,joint_count> q{},v{},target{};
+ bool seeded=false,first=false;
+ double vmax=.25,amax=.5,omega=4.;
+ void seed(const std::array<double,joint_count>& measured){q=target=measured;v.fill(0);seeded=first=true;}
+ bool set(const std::array<double,joint_count>& next){
+  for(double x:next)if(!std::isfinite(x))return false;
+  target=next;return seeded;
+ }
+ bool step(double dt){
+  if(!seeded || !std::isfinite(dt) || dt<=0 || dt>.01)return false;
+  if(first){first=false;return true;}
+  // Scale the whole acceleration vector, then its step toward the speed
+  // boundary. No independent axis clipping; preserve v across retargets.
+  std::array<double,joint_count> acceleration{};double scale=1.;
+  for(unsigned i=0;i<joint_count;++i){
+   acceleration[i]=omega*omega*(target[i]-q[i])-2*omega*v[i];
+   if(std::abs(acceleration[i])>amax)scale=std::min(scale,amax/std::abs(acceleration[i]));
+  }
+  double progress=1.;
+  for(unsigned i=0;i<joint_count;++i){
+   const double dv=acceleration[i]*scale*dt;
+   if(dv>0)progress=std::min(progress,(vmax-v[i])/dv);
+   else if(dv<0)progress=std::min(progress,(-vmax-v[i])/dv);
+  }
+  progress=std::clamp(progress,0.,1.);
+  for(unsigned i=0;i<joint_count;++i){
+   const double next_v=v[i]+progress*scale*acceleration[i]*dt;
+   q[i]+=(v[i]+next_v)*.5*dt;v[i]=next_v;
+  }
+  return true;
+ }
+};
+constexpr std::array<double,joint_count> lower{-3.14,0.0,-2.61,-1.57,-3.14,-1.309,-1.274,-3.14,-3.14,-0.58,-1.57,-3.14,-1.309,-1.274,-1.17,-.79};
+constexpr std::array<double,joint_count> upper{3.14,3.14,0.58,1.57,3.14,1.274,1.449,3.14,0.0,2.61,1.57,3.14,1.274,1.449,1.17,.55};
+inline bool in_limits(const std::array<double,joint_count>& q){
+ for(unsigned i=0;i<joint_count;++i){
+  if(!std::isfinite(q[i]) || q[i]<lower[i] || q[i]>upper[i])return false;
+ }
+ return true;
+}
+} // namespace position_session
