+// A local shutdown action keeps the admitted mode, controller state and masks.
+// Only this node's SIGINT/SIGTERM handler can select it; no client TTL is renewed.
+bool ServoNode::position_shutdown_control(double dt){
+    (void)dt;return true;
+}
+bool ServoNode::position_shutdown_tick(){
+    using namespace position_session;
+    const auto now=steady_ns();const auto obs=EtherCAT_positionObservation();
+    if(position_shutdown_.phase==Shutdown::Phase::Idle){
+        std::cout << "收到退出请求：保留当前控制模式，停止后回位。" << std::endl;
+        bool enabled=obs.output_valid && obs.reference_valid && measured(obs,now);
+        for(unsigned i=0;i<joint_count;++i)if((obs.status[position_slot(i)]&0x6f)!=0x27)enabled=false;
+        if(!position_startup_complete_ || !position_output_.selected || !enabled || obs.session_reason>PAUSED){
+            position_shutdown_.disable(now,position_output_.selected?"shutdown_not_ready_or_faulted":nullptr);
+        }else{
+            TargetSnapshot seed;
+            const auto ros=this->now().nanoseconds();
+            bool seeded=position_trajectory_.snapshot(ros,now,2,position_target_prepare_ns_,position_feedback_.q,seed);
+            // A completed local PAUSE remains valid after the original relay TTL.
+            if(!seeded && position_local_hold_ && obs.trajectory_phase==4){
+                seed.q=obs.reference_position;seed.v=obs.reference_speed;seed.a=obs.reference_acceleration;
+                seed.effective_steady=now+position_target_prepare_ns_;seed.valid=true;seeded=true;
+            }
+            std::array<double,joint_count> goal{};
+            for(unsigned i=0;i<7;++i){goal[i]=lArm_shutdownPos[i];goal[i+7]=rArm_shutdownPos[i];}
+            if(!seeded)position_shutdown_.disable(now,"shutdown_reference_unavailable");
+            else position_shutdown_.begin(seed,goal,trajectory_max_velocity_,trajectory_max_acceleration_,
+                trajectory_max_jerk_,now,std::chrono::duration<double>(kShutdownTimeout).count());
+        }
+    }
+    const bool prepared=position_shutdown_.poll(now);
+    if(!prepared){
+        // Follow the original dated timeline until the prepared brake starts.
+        // Its finite local shutdown deadline is separate from the client TTL.
+        if(!position_local_hold_ && !position_trajectory_.sample(now))position_shutdown_.disable(now,"shutdown_reference_expired");
+        else if(!position_local_hold_){
+            position_output_.reference_position=position_trajectory_.q;
+            position_output_.reference_speed=position_trajectory_.v;
+            position_output_.reference_acceleration=position_trajectory_.a;
+        }
+        position_output_.shutdown=true;position_output_.nominal_hold=false;
+        position_output_.shutdown_deadline=position_shutdown_.deadline();
+    }
+    position_shutdown_.tick(now,obs,position_output_,position_trajectory_.tuning().takeover_velocity_tolerance_rad_s);
+    if(position_shutdown_.sampling() || (!prepared && position_shutdown_.phase==Shutdown::Phase::Planning)){
+        bool valid=measured(obs,now) && obs.output_valid && obs.session_reason<=PAUSED;
+        for(unsigned i=0;i<joint_count;++i){
+            const auto q=position_output_.reference_position[i];
+            if(!std::isfinite(q) || q<lower[i] || q>upper[i] || std::abs(q-obs.position[position_slot(i)])>.5)valid=false;
+            position_output_.q[i]=float(q);position_output_.v[i]=float(position_output_.reference_speed[i]);
+        }
+        const auto dt=position_interval_.tick(now);
+        if(!valid || !std::isfinite(dt) || dt<=0 || dt>.01 || !position_shutdown_control(dt)){
+            position_output_.failure_reason=CYCLE_OR_TRACKING_ERROR;
+            position_shutdown_.disable(now,"shutdown_tracking_or_control_failed");
+            position_shutdown_.tick(now,obs,position_output_,.01);
+        }
+    }
+    position_output_.rt_deadline=now+20000000;
+    EtherCAT_positionOutput(position_output_);
+    if(position_shutdown_.phase!=Shutdown::Phase::Done)return false;
+    shutdown_exit_code_=position_shutdown_.failed()?1:0;
+    std::cout << "关机结果: " << position_shutdown_.reason() << "; disable="
+              << (obs.shutdown_disabled?"confirmed":"unconfirmed") << "; brake=unverified" << std::endl;
+    return true;
 }
