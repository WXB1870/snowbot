+// A local shutdown action keeps the admitted mode, controller state and masks.
+// Only this node's SIGINT/SIGTERM handler can select it; no client TTL is renewed.
+bool ServoNode::position_shutdown_control(double dt){
+    (void)dt;return true;
+}
+bool ServoNode::position_shutdown_tick(){
+    using namespace position_session;
+    const auto now=steady_ns();const auto obs=EtherCAT_positionObservation();
+    const bool fresh=now-obs.sampled_ns<=20000000;
+    const int64_t timeout=std::chrono::duration_cast<std::chrono::nanoseconds>(kShutdownTimeout).count();
+    const auto disable=[&](const std::string& reason){
+        if(!reason.empty())shutdown_error_=reason;
+        if(shutdown_phase_!=ShutdownDisabling){shutdown_phase_=ShutdownDisabling;shutdown_deadline_=now+timeout;}
+    };
+    if(shutdown_phase_==ShutdownIdle){
+        std::cout << "收到退出请求：保留当前控制模式，停止后失能，不自动回位。" << std::endl;
+        shutdown_deadline_=now+timeout;shutdown_phase_=ShutdownPlanning;
+        if(!position_startup_complete_ || !position_output_.selected || !obs.reference_valid)
+            disable(position_output_.selected?"shutdown_not_ready_or_faulted":"");
+    }
+    // Consume the RT watchdog result and cached observation age, without
+    // repeating drive/fault scans or clearing its latch.
+    if(shutdown_phase_<ShutdownDisabling && (!obs.output_valid || !fresh))
+        disable("shutdown_feedback_or_latched_fault");
+    if(shutdown_phase_==ShutdownPlanning){
+        if(auto result=position_admission_->poll()){
+            if(result->shutdown){
+                if(!result->error.empty())disable(result->error);
+                else if(result->completed_ns>shutdown_seed_.effective_steady)disable("shutdown_plan_late");
+                else{
+                    shutdown_brake_=std::move(result->prepared->segment);
+                    shutdown_start_=shutdown_seed_.effective_steady;shutdown_phase_=ShutdownStopping;
+                    shutdown_deadline_=shutdown_start_+int64_t(shutdown_brake_->end()*1e9)+timeout;
+                }
+            }
+            position_admission_->release(result);
+        }
+        if(shutdown_phase_==ShutdownPlanning && !shutdown_requested_ && !position_admission_->busy()){
+            bool seeded=position_trajectory_.snapshot(this->now().nanoseconds(),now,2,position_target_prepare_ns_,position_feedback_.q,shutdown_seed_);
+            if(!seeded && position_local_hold_){
+                shutdown_seed_.q=obs.reference_position;shutdown_seed_.v=obs.reference_speed;shutdown_seed_.a=obs.reference_acceleration;
+                shutdown_seed_.effective_steady=now+position_target_prepare_ns_;seeded=true;
+            }
+            if(!seeded)disable("shutdown_reference_unavailable");
+            else shutdown_requested_=position_admission_->submit_shutdown(shutdown_seed_,
+                trajectory_max_velocity_,trajectory_max_acceleration_,trajectory_max_jerk_,timeout*1e-9);
+        }
+        if(shutdown_phase_==ShutdownPlanning && shutdown_requested_ && now>=shutdown_seed_.effective_steady)
+            disable("shutdown_plan_late");
+    }
+    if(shutdown_phase_<ShutdownDisabling && now>=shutdown_deadline_)disable("shutdown_timeout");
+    auto& output=position_output_;
+    output.shutdown=true;output.nominal_hold=false;
+    if(shutdown_phase_<ShutdownDisabling){
+        if(shutdown_phase_==ShutdownPlanning || now<shutdown_start_){
+            if(!position_local_hold_){
+                position_trajectory_.sample(now);
+                output.reference_position=position_trajectory_.q;output.reference_speed=position_trajectory_.v;output.reference_acceleration=position_trajectory_.a;
+            }
+        }else{
+            const auto& curve=shutdown_brake_;
+            const auto elapsed=std::min((now-shutdown_start_)*1e-9,curve->end());
