+// No enable, homing or zero targets during servo initialization.
+void ServoNode::position_startup(){
+    position_session::Observation obs;
+    for(unsigned i=0;i<200 && !sigInterrupt.load();++i){
+        obs=EtherCAT_positionObservation();
+        if(position_session::measured(obs,position_session::steady_ns()))break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    position_startup_complete_=position_session::measured(obs,position_session::steady_ns()) && !sigInterrupt.load();
+    position_initialized_=position_startup_complete_;drive_startup_finished_=!sigInterrupt.load();
+    position_init_error_=position_initialized_?"":"pdo_feedback_unavailable";
+    if(!position_initialized_)return;
+    EtherCATmsg_Get();
+    for(unsigned i=0;i<7;++i){
+        servo_desMsg_orig[i].joint_pos=lArm_pos_receive[i]=obs.position[i];
+        servo_desMsg_orig[i+7].joint_pos=rArm_pos_receive[i]=obs.position[i+8];
+    }
+    g_left_pos_curr=obs.position[7];g_right_pos_curr=obs.position[15];
+    for(unsigned i=0;i<2;++i){h_pos_curr[i]=obs.position[16+i];t_pos_curr[i]=obs.position[18+i];}
+}
