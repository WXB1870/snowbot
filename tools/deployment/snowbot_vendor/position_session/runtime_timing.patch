+// Only the telemetry worker calls this method. Keep the original acquisition
+// timestamp; never re-date a sample delayed behind DDS backpressure.
+void ServoNode::feedback_send(){
+    FeedbackSample sample;
+    if(!feedback_mailbox_.take(sample))return;
+    const auto age=position_session::steady_ns()-sample.sampled_ns;
+    if(age<0 || age>20000000)return;
+    sample.message.if_first_time=feedback_first_sent_ ? 0 : 1;
+    RetData_pub->publish(sample.message);
+    feedback_first_sent_=true;
 }

