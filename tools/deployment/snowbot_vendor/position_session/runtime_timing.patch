+// Diagnostic bookkeeping belongs to the single ROS/main thread only.
+// Fixed storage; no RT reader, allocation, logging or control decisions.
+struct LoopSpan { int64_t begin=0,end=0; };
+class LoopTiming {
+public:
+ enum Phase:unsigned {Prepare,FeedbackPublish,SpinHead,Compute,Admission,Sample,LegacyIO,WrenchPublish,SpinTail,Sleep,Count};
+ struct Snapshot { std::array<LoopSpan,Count> last{},longest{};uint64_t session=0; };
+private:
+ Snapshot spans_{};unsigned phase_=Count;int64_t begin_=0;
+ static void finish(Snapshot& s,unsigned phase,int64_t begin,int64_t end){
+  if(phase>=Count || begin<=0 || end<begin)return;
+  s.last[phase]={begin,end};
+  if(end-begin>s.longest[phase].end-s.longest[phase].begin)s.longest[phase]={begin,end};
+ }
+public:
+ void bind(uint64_t session){if(session!=spans_.session){spans_={};spans_.session=session;phase_=Count;begin_=0;}}
+ void mark(Phase phase,int64_t now){
+  if(!spans_.session)return;
+  finish(spans_,phase_,begin_,now);phase_=phase;begin_=now;
+ }
+ Snapshot snapshot(int64_t now)const{auto s=spans_;finish(s,phase_,begin_,now);return s;}
+};
+// One producer / one consumer, latest-only telemetry handoff. A blocked DDS
+// publisher cannot hold a lock or accumulate a queue on the control thread.
+template<class T> class LatestTelemetry {
+ std::array<T,3> slots_{};std::atomic<unsigned> middle_{1};
+ unsigned back_=2,front_=0;
+public:
+ static_assert(std::atomic<unsigned>::is_always_lock_free,"lock-free telemetry required");
+ void put(const T& value){slots_[back_]=value;back_=middle_.exchange(back_|4u,std::memory_order_acq_rel)&3u;}
+ bool take(T& value){
+  if(!(middle_.load(std::memory_order_acquire)&4u))return false;
+  front_=middle_.exchange(front_,std::memory_order_acq_rel)&3u;value=slots_[front_];return true;
+ }
+};
 } // namespace position_session
