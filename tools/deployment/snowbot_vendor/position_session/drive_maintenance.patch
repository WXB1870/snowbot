+std::string EtherCATDriver::driveDiagnostics() {
+    const auto s=observation();const auto now=position_session::steady_ns();
+    const double age=s.sampled_ns>0 && now>=s.sampled_ns?(now-s.sampled_ns)*1e-6:-1.;
+    std::ostringstream out;
+    out << "sample=" << s.sample << " age_ms=" << age << " wkc=" << s.wkc << "/" << s.expected_wkc
+        << " valid=0x" << std::hex << s.valid_mask << " fault_mask=0x" << drive_maintenance::faults(s)
+        << " reset_target=0x" << drive_reset_.target() << std::dec << " reset=" << drive_maintenance::name(drive_reset_.state())
+        << "\nmanufacturer_error_code=unavailable_not_mapped; controlwords=requests_cached_separately; q=rad v=rad/s";
+    for(unsigned i=0;i<20;++i) {
+        const char* group=i<8?"L":i<16?"R":i<18?"Head":"Waist";
+        const unsigned joint=i<16?i%8+1:i%2+1;
+        out << "\n" << group << joint << " slot=" << i << " valid=" << bool(s.valid_mask&(1u<<i))
+            << " sw=0x" << std::hex << s.status[i] << " cw=0x" << motor_sent_cw_[i].load() << std::dec
+            << " fault=" << bool(s.status[i]&8) << " operation_enabled=" << bool(s.status[i]&4)
+            << " requested=" << motor_enable_mask_[i].load() << " q=" << s.position[i] << " v=" << s.speed[i];
+        if(i>=16){const auto k=i-16;
+            out << " csp_send_attempt_ns=" << s.csp.send_attempt_ns
+                << " csp_command_available=" << bool(s.csp.command_mask&(1u<<i))
+                << " csp_feedback_valid=" << bool(s.csp.feedback_mask&(1u<<i))
+                << " csp_cw=" << s.csp.controlword[k]
+                << " mode_command=" << int(s.csp.mode_command[k]) << " mode_display=" << int(s.csp.mode_display[k])
+                << " target_position_raw=" << s.csp.target_position[k] << " target_velocity_raw=" << s.csp.target_velocity[k]
+                << " target_torque_raw=" << s.csp.target_torque[k]
+                << " actual_position_raw=" << s.csp.actual_position[k] << " actual_velocity_raw=" << s.csp.actual_velocity[k];
+        }
+    }
+    return out.str();
+}
