+#pragma once
+#include "servo_control/position_observation.h"
+#include <atomic>
+
+namespace drive_maintenance {
+constexpr uint32_t all_axes = 0xfffff;
+enum State : unsigned { idle, queued, low, pulse, verify, cleared, rejected, aborted, fault_remains };
+inline bool active(State s) { return s >= queued && s <= verify; }
+inline const char* name(State s) {
+    switch(s) {
+    case idle:return "idle"; case queued:return "queued_not_completed";
+    case low:return "reset_low"; case pulse:return "reset_pulse"; case verify:return "waiting_fault_clear";
+    case cleared:return "fault_clear_observed_disabled"; case rejected:return "rejected_interlock";
+    case aborted:return "aborted_interlock_or_pdo"; case fault_remains:return "fault_remains_no_retry";
+    } return "unknown";
+}
+inline uint32_t faults(const position_session::Observation& s) {
+    uint32_t mask=0; for(unsigned i=0;i<20;++i) if(s.status[i]&8u)mask|=1u<<i; return mask;
+}
+// One ROS requester, one existing PDO writer. No bus calls, allocation or sleeps.
+// Terminal states are retained until another explicit manual request.
+class Reset {
+    std::atomic<State> state_{idle};
+    std::atomic<uint32_t> target_{0};
+    int64_t phase_ns_=0,started_ns_=0;
+    uint64_t last_sample_=0;
+public:
+    State state() const { return state_.load(); }
+    uint32_t target() const { return target_.load(); }
+    bool busy() const { return active(state()); }
+    bool request() {
+        State old=state();
+        return !active(old) && state_.compare_exchange_strong(old,queued);
+    }
+    // While true, caller suppresses every normal command writer for this cycle.
+    bool step(const position_session::Observation& s, int64_t now,
+              uint32_t requested, bool selected, bool exiting, uint32_t& pulse_mask) {
+        pulse_mask=0;
+        const auto phase=state();
+        if(!active(phase))return false;
+        bool safe=!requested && !selected && !exiting && s.sample>0 &&
+            s.valid_mask==all_axes && s.expected_wkc>0 && s.wkc==s.expected_wkc &&
+            s.sampled_ns>0 && now>=s.sampled_ns && now-s.sampled_ns<=20000000;
+        for(unsigned i=0;i<20;++i) safe=safe && !(s.status[i]&4u);
+        if(!safe){state_.store(phase==queued?rejected:aborted);return phase!=queued;}
+        if(phase==queued) {
+            target_.store(faults(s));phase_ns_=started_ns_=now;last_sample_=s.sample;
+            state_.store(target()?low:cleared);return true;
+        }
+        if(now<phase_ns_ || now-started_ns_>600000000){state_.store(fault_remains);return true;}
+        // No pulse or successful result without a new successful PDO receive.
+        const bool advanced=s.sample>last_sample_;last_sample_=s.sample;
+        if(!advanced){state_.store(aborted);return true;}
+        if(phase==low && now-phase_ns_>=10000000){phase_ns_=now;state_.store(pulse);}
+        if(state()==pulse) {
+            if(now-phase_ns_<10000000)pulse_mask=target();
+            else{phase_ns_=now;state_.store(verify);}
+        } else if(phase==verify && now-phase_ns_>=10000000 && !faults(s))state_.store(cleared);
+        return true;
+    }
+};
+// Only the fault-reset bit may be asserted; switch-on/voltage/operation bits stay clear.
+inline uint16_t reset_controlword(uint32_t pulse_mask,unsigned axis) {
+    return (pulse_mask&(1u<<axis))?0x0080:0x0000;
+}
+} // namespace drive_maintenance
